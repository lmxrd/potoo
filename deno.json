{
  "nodeModulesDir": "none",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.13",
    "@halvardm/nessie": "jsr:@halvardm/nessie@3.0.0-rc.3",
    "@stdx/database": "jsr:@stdx/database@^0.1.1",
    "@zod/zod": "jsr:@zod/zod@^4.6.5",
    "maxmind": "npm:maxmind@^5.0.0"
  },
  "tasks": {
    "dev": "deno run -A --watch backend/main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env backend/main.ts",
    "build": "cd frontend && pnpm install && pnpm build && cd .. && deno compile --allow-net --allow-read --allow-write --allow-env --include backend/db/migrations --include frontend/dist --output potoo backend/main.ts",
    "check": "deno check backend/main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env backend/"
  },
  "exclude": ["frontend", "data"]
}
